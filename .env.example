APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HanbellShop
# ---------------------------------------------------------------------------
# Locales offered in the language switcher. Keys must exist under lang/.
HANBELL_SUPPORTED_LOCALES=en,ha,ig,yo,fr,ar

# Store identity
HANBELL_STORE_NAME=HanbellShop
HANBELL_TAGLINE="Quality Nigerian fashion, at Hanbell prices."
HANBELL_SUPPORT_EMAIL=hello@hanbellshop.test
HANBELL_SUPPORT_PHONE="+234 800 000 0000"
HANBELL_WHATSAPP="+2348000000000"
HANBELL_ADDRESS="Lagos, Nigeria"

# ---------------------------------------------------------------------------
# Operating entity
# ---------------------------------------------------------------------------
# HanbellShop is a trading name of Bellah Options. Financial and legal documents
# (invoices, receipts, credit notes, vendor statements, the terms of service)
# name this entity, because an invoice has to identify who is actually charging.
#
# The registration, tax and address fields are intentionally blank. A Nigerian
# invoice is expected to carry the issuer's RC number and TIN, and inventing them
# would produce documents that look authoritative and are wrong. Fill them in
# before issuing a real invoice — any line left blank is omitted from the PDF
# rather than printed as a placeholder.
HANBELL_OPERATOR_NAME=Bellah Options
HANBELL_OPERATOR_RC=
HANBELL_OPERATOR_TIN=
HANBELL_OPERATOR_VAT=
HANBELL_OPERATOR_ADDRESS=
HANBELL_OPERATOR_CITY=
HANBELL_OPERATOR_STATE=
HANBELL_OPERATOR_COUNTRY=NG
HANBELL_OPERATOR_WEBSITE=
HANBELL_OPERATOR_JURISDICTION="the Federal Republic of Nigeria"
HANBELL_COMPLAINT_DAYS=30

# ---------------------------------------------------------------------------
# PDF documents
# ---------------------------------------------------------------------------
HANBELL_PDF_PAPER=a4
HANBELL_PDF_DISK=local
HANBELL_PDF_LINK_TTL_DAYS=30

# Commerce — all monetary values are integer minor units (kobo)
HANBELL_CURRENCY=NGN
HANBELL_COMMISSION_DEFAULT_PERCENT=12
HANBELL_FLAT_SHIPPING_MINOR=200000
HANBELL_FREE_SHIPPING_THRESHOLD_MINOR=5000000
HANBELL_VAT_PERCENT=7.5
HANBELL_PRICES_INCLUDE_TAX=true

# URL tokens: public URLs carry a signed, expiring token instead of an id/uuid.
HANBELL_TOKEN_TTL_DAYS=30

# Advertising — hosts an ad may redirect to (anything else is refused)
HANBELL_AD_ALLOWED_HOSTS=hanbellshop.test,www.hanbellshop.test,instagram.com,facebook.com,x.com,tiktok.com,youtube.com
HANBELL_AD_AGGREGATE_DAYS=30

# SEO & LLM
HANBELL_SEO_TITLE_SUFFIX=HanbellShop
HANBELL_TWITTER_HANDLE="@hanbellshop"
HANBELL_LLMS_TXT=true
HANBELL_SITEMAP_CACHE_MINUTES=60

# Demo data. Set HANBELL_DEMO_DATA=false before any public deployment.
HANBELL_DEMO_DATA=true
HANBELL_DEMO_DISCLOSURE=true

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# A gateway only appears at checkout once its keys are present. With none set,
# the checkout says so plainly rather than faking a payment.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Offline rails
HANBELL_BANK_NAME="Hanbell Demo Bank"
HANBELL_BANK_ACCOUNT_NAME="HanbellShop Ltd"
HANBELL_BANK_ACCOUNT_NUMBER=0123456789
HANBELL_COD_ENABLED=true
HANBELL_COD_FEE_MINOR=0

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
HANBELL_MEDIA_DISK=public
HANBELL_MAX_UPLOAD_KB=4096

